# Copy to .env and fill in. .env holds secrets: never commit it.

# --- Required ---------------------------------------------------------------
# Long random strings. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Public address of the hub, used for links in emails.
SITE_URL=https://folsm-aihub.sites.er.kcl.ac.uk

# --- Optional ---------------------------------------------------------------
# Port on the host machine (the app listens on 8000 inside the container).
HUB_PORT=8000

# Extra admins / committee members (comma separated). The built-in admin is in
# hub/config.py (DEFAULT_ADMIN_EMAILS).
HUB_ADMIN_EMAILS=
HUB_COMMITTEE_EMAILS=

# Outgoing email. Leave MAIL_SERVER empty to log emails instead of sending.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
